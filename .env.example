# Backend
HOST=0.0.0.0
PORT=8787
DRY_RUN=true
DEFAULT_SIZE=0.01

# Hyperliquid TESTNET only (never mainnet)
# HL_PRIVATE_KEY=0x...
# HL_ACCOUNT_ADDRESS=0x...
# HL_API_URL=https://api.hyperliquid-testnet.xyz

# Optional: deployed NEP-171 contract on NEAR testnet
# NEAR_CONTRACT_ID=perp-agent.youraccount.testnet
# NEAR_NETWORK=testnet

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT=perp-agent-nft.testnet

# Free WalletConnect / Reown Cloud project id (required for mobile deep-link
# handoff from Safari/Chrome into Meteor App). Create at https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=4313f4a6fd453f6be60baa5c554e8971
